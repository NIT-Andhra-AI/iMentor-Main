# =============================================================
# iMentor V2 — Single Production Deployment Caddyfile
# =============================================================
# Target Services (iMentor V2):
#   Frontend:    localhost:3006 (Vite React)
#   Backend API: localhost:5006 (Express / Node.js)
#   Python RAG:  localhost:2006 (FastAPI / Qdrant / Neo4j)
#   Go Gateway:  localhost:5002 (Go API Gateway)
#   SGLang LLM:  localhost:8000 (Local Qwen Server)
#
# Entrypoints:
#   HTTPS (Port 443):  https://61.0.228.124 (Primary Production)
#   HTTPS (Port 2000): Redirects legacy port 2000 to standard 443
#   HTTP  (Port 80):   Permanent Redirect to HTTPS
# =============================================================
{
	admin off
	email admin@nitandhra.ac.in
}

# ── HTTP -> HTTPS redirect ──────────────────────────────────────────────
http://61.0.228.124, http://45.118.208.34, http://172.180.14.125, http://localhost {
	redir https://{host}{uri} permanent
}

# ── iMentor V2 (Primary Production) — Standard HTTPS (Port 443) ───────────
https://61.0.228.124, https://45.118.208.34, https://172.180.14.125, https://localhost {
	tls /home/sri/Downloads/iMentor_march/certs/imentor.crt /home/sri/Downloads/iMentor_march/certs/imentor.key

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Permissions-Policy "geolocation=(), microphone=(self), camera=()"
		-Server
	}

	handle /testaddr {
		respond "iMentor V2 Production is running!
Remote: {remote_host}
Host: {host}
" 200
	}

	handle /api/* {
		reverse_proxy localhost:5006 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			flush_interval -1
			transport http {
				read_timeout 600s
				write_timeout 600s
				dial_timeout 60s
			}
		}
	}

	handle /rag/* {
		uri strip_prefix /rag
		reverse_proxy localhost:2006 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			flush_interval -1
			transport http {
				read_timeout 600s
				write_timeout 600s
				dial_timeout 60s
			}
		}
	}

	handle /socket.io/* {
		reverse_proxy localhost:5006 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}
			flush_interval -1
			transport http {
				read_timeout 86400s
				write_timeout 86400s
			}
		}
	}

	handle /gateway/* {
		uri strip_prefix /gateway
		reverse_proxy localhost:5002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /course_bootstrap/* {
		reverse_proxy localhost:5006 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /metrics {
		reverse_proxy localhost:5006
	}

	@dotfiles path_regexp /\.
	respond @dotfiles 403

	handle {
		reverse_proxy localhost:3006 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}
			flush_interval -1
		}
	}

	log {
		output file /var/log/caddy/imentor_v2_access.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

# ── Backward Compatibility: Alternate HTTPS (Port 2000) ─────────────────
# Redirects any legacy traffic or bookmarks from port 2000 to primary HTTPS (port 443)
https://61.0.228.124:2000, https://45.118.208.34:2000, https://172.180.14.125:2000, https://localhost:2000 {
	tls /home/sri/Downloads/iMentor_march/certs/imentor.crt /home/sri/Downloads/iMentor_march/certs/imentor.key
	redir https://{host}{uri} permanent
}
